{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohhi.md/schema/ohhi.changes.v1.schema.json",
  "title": "ohhi.changes.v1",
  "description": "Paths changed since an instant or since a journal sequence.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ohhi.changes.v1"
    },
    "since": {
      "type": "string"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Vault-relative POSIX path, e.g. `Areas/CS/JSON.md`",
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "modified",
              "created",
              "journaled"
            ]
          },
          "at": {
            "type": "string"
          },
          "seq": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "path",
          "kind",
          "at"
        ],
        "additionalProperties": false
      }
    },
    "cursorSince": {
      "type": "string"
    },
    "returned": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "since",
    "changes",
    "cursorSince",
    "returned",
    "total",
    "nextCursor"
  ],
  "additionalProperties": false
}
