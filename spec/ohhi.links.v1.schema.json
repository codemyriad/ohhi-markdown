{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohhi.md/schema/ohhi.links.v1.schema.json",
  "title": "ohhi.links.v1",
  "description": "Wikilinks written in a note, with their resolution.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ohhi.links.v1"
    },
    "path": {
      "description": "Vault-relative POSIX path, e.g. `Areas/CS/JSON.md`",
      "type": "string",
      "minLength": 1
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "alias": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "anchor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "embed": {
            "type": "boolean"
          },
          "resolved": {
            "anyOf": [
              {
                "description": "Vault-relative POSIX path, e.g. `Areas/CS/JSON.md`",
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "context": {
            "type": "string"
          }
        },
        "required": [
          "target",
          "alias",
          "anchor",
          "embed",
          "resolved",
          "line",
          "context"
        ],
        "additionalProperties": false
      }
    },
    "returned": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "path",
    "links",
    "returned",
    "total",
    "nextCursor"
  ],
  "additionalProperties": false
}
