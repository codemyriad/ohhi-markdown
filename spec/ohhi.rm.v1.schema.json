{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohhi.md/schema/ohhi.rm.v1.schema.json",
  "title": "ohhi.rm.v1",
  "description": "Move a note or folder to .trash/ (never deletes outright).",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ohhi.rm.v1"
    },
    "path": {
      "description": "Vault-relative POSIX path, e.g. `Areas/CS/JSON.md`",
      "type": "string",
      "minLength": 1
    },
    "trashedTo": {
      "type": "string"
    },
    "files": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "dryRun": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "path",
    "trashedTo",
    "files",
    "dryRun"
  ],
  "additionalProperties": false
}
