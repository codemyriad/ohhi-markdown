{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohhi.md/schema/ohhi.append.v1.schema.json",
  "title": "ohhi.append.v1",
  "description": "Append text to a note or to one of its sections (journaled, atomic).",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ohhi.append.v1"
    },
    "path": {
      "description": "Vault-relative POSIX path, e.g. `Areas/CS/JSON.md`",
      "type": "string",
      "minLength": 1
    },
    "line": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "hash": {
      "type": "string"
    },
    "journalSeq": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "dryRun": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "path",
    "line",
    "hash",
    "journalSeq",
    "dryRun"
  ],
  "additionalProperties": false
}
