{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohhi.md/schema/ohhi.ls.v1.schema.json",
  "title": "ohhi.ls.v1",
  "description": "List notes, binaries and folders under a directory.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ohhi.ls.v1"
    },
    "dir": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Vault-relative POSIX path, e.g. `Areas/CS/JSON.md`",
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "text",
              "binary",
              "dir"
            ]
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "mtime": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "returned": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "type": "object",
      "properties": {
        "docs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skippedBinary": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ignored": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "docs",
        "skippedBinary",
        "ignored"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "dir",
    "items",
    "returned",
    "total",
    "nextCursor",
    "coverage"
  ],
  "additionalProperties": false
}
