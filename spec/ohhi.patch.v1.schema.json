{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohhi.md/schema/ohhi.patch.v1.schema.json",
  "title": "ohhi.patch.v1",
  "description": "Replace one exact string in a note (journaled, atomic). Refused when the string is not unique.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ohhi.patch.v1"
    },
    "path": {
      "description": "Vault-relative POSIX path, e.g. `Areas/CS/JSON.md`",
      "type": "string",
      "minLength": 1
    },
    "replaced": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "hash": {
      "type": "string"
    },
    "journalSeq": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "dryRun": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "path",
    "replaced",
    "hash",
    "journalSeq",
    "dryRun"
  ],
  "additionalProperties": false
}
