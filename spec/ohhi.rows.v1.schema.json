{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohhi.md/schema/ohhi.rows.v1.schema.json",
  "title": "ohhi.rows.v1",
  "description": "The rows of a collection view — notes as references plus the columns asked for; filter further with --where.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ohhi.rows.v1"
    },
    "collection": {
      "anyOf": [
        {
          "description": "Vault-relative POSIX path, e.g. `Areas/CS/JSON.md`",
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "view": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Vault-relative POSIX path, e.g. `Areas/CS/JSON.md`",
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "values": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      },
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              ]
            }
          }
        },
        "required": [
          "path",
          "name",
          "values"
        ],
        "additionalProperties": false
      }
    },
    "supported": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "returned": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "type": "object",
      "properties": {
        "docs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skippedBinary": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ignored": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "docs",
        "skippedBinary",
        "ignored"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "collection",
    "view",
    "columns",
    "rows",
    "supported",
    "reasons",
    "returned",
    "total",
    "nextCursor",
    "coverage"
  ],
  "additionalProperties": false
}
