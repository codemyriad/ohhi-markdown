{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohhi.md/schema/ohhi.skills.v1.schema.json",
  "title": "ohhi.skills.v1",
  "description": "Skills in the vault (`.agents/skills/`): name, description, kind, input, output and validation problems.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ohhi.skills.v1"
    },
    "dir": {
      "type": "string"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "dir": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "check",
              "transform",
              "generate",
              "research"
            ]
          },
          "input": {
            "type": "string",
            "enum": [
              "selection",
              "section",
              "note",
              "folder"
            ]
          },
          "output": {
            "type": "string",
            "enum": [
              "replace",
              "insert",
              "annotate",
              "new-note"
            ]
          },
          "hasScripts": {
            "type": "boolean"
          },
          "problems": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "name",
          "description",
          "dir",
          "hasScripts",
          "problems"
        ],
        "additionalProperties": false
      }
    },
    "returned": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "dir",
    "skills",
    "returned",
    "total",
    "nextCursor"
  ],
  "additionalProperties": false
}
