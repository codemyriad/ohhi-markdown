{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohhi.md/schema/ohhi.tags.v1.schema.json",
  "title": "ohhi.tags.v1",
  "description": "Tags in the vault with note counts.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ohhi.tags.v1"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tag": {
            "type": "string"
          },
          "notes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "tag",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "returned": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "tags",
    "returned",
    "total",
    "nextCursor"
  ],
  "additionalProperties": false
}
