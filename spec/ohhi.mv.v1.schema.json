{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohhi.md/schema/ohhi.mv.v1.schema.json",
  "title": "ohhi.mv.v1",
  "description": "Move or rename a note or folder.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ohhi.mv.v1"
    },
    "from": {
      "description": "Vault-relative POSIX path, e.g. `Areas/CS/JSON.md`",
      "type": "string",
      "minLength": 1
    },
    "to": {
      "description": "Vault-relative POSIX path, e.g. `Areas/CS/JSON.md`",
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "dryRun": {
      "type": "boolean"
    }
  },
  "required": [
    "schema",
    "from",
    "to",
    "files",
    "dryRun"
  ],
  "additionalProperties": false
}
