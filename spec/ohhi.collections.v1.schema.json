{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohhi.md/schema/ohhi.collections.v1.schema.json",
  "title": "ohhi.collections.v1",
  "description": "Collections in the vault (`.base` files): their views and row counts.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ohhi.collections.v1"
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Vault-relative POSIX path, e.g. `Areas/CS/JSON.md`",
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "views": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "rows": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "supported": {
                  "type": "boolean"
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "name",
                "type",
                "rows",
                "supported",
                "reasons"
              ],
              "additionalProperties": false
            }
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "path",
          "name",
          "views",
          "issues",
          "error"
        ],
        "additionalProperties": false
      }
    },
    "returned": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "coverage": {
      "type": "object",
      "properties": {
        "docs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skippedBinary": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "ignored": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "docs",
        "skippedBinary",
        "ignored"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "collections",
    "returned",
    "total",
    "nextCursor",
    "coverage"
  ],
  "additionalProperties": false
}
