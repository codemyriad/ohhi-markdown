{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohhi.md/schema/ohhi.stats.v1.schema.json",
  "title": "ohhi.stats.v1",
  "description": "What the index covers: notes, links, tags, binaries skipped, folders ignored.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ohhi.stats.v1"
    },
    "vault": {
      "type": "string"
    },
    "docs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "terms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "links": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "unresolved": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tags": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "skippedBinary": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "ignored": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "buildMs": {
      "type": "number",
      "minimum": 0
    },
    "indexSchemaVersion": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema",
    "vault",
    "docs",
    "terms",
    "links",
    "unresolved",
    "tags",
    "skippedBinary",
    "ignored",
    "buildMs",
    "indexSchemaVersion"
  ],
  "additionalProperties": false
}
