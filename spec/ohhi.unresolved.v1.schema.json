{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ohhi.md/schema/ohhi.unresolved.v1.schema.json",
  "title": "ohhi.unresolved.v1",
  "description": "Wikilinks whose target does not exist — the note-creation queue.",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "ohhi.unresolved.v1"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "description": "Vault-relative POSIX path, e.g. `Areas/CS/JSON.md`",
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "context": {
            "type": "string"
          },
          "embed": {
            "type": "boolean"
          }
        },
        "required": [
          "path",
          "target",
          "line",
          "context",
          "embed"
        ],
        "additionalProperties": false
      }
    },
    "returned": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "nextCursor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "links",
    "returned",
    "total",
    "nextCursor"
  ],
  "additionalProperties": false
}
