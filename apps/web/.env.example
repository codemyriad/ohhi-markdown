# Build-time settings for apps/web: copy to `.env.local` (git-ignored) or set
# them in the environment of `vite build`. Vite inlines VITE_* at BUILD time —
# changing one means rebuilding. Nothing here is secret.

# The relay fresh installs propose for new shares: ws:// or wss://; unset or
# malformed → ws://localhost:8787. A relay saved in Settings › Sync always wins
# (installs from builds before this variable keep their ws://localhost:8787).
VITE_DEFAULT_RELAY=wss://relay.example.com

# Where this deployment keeps the operator secret, as one sentence the secret
# field's "Where do I get this?" shows (e.g. the team password manager, under
# ohhi relay). Unset → the app says nothing about where. Never the secret itself.
VITE_TEAM_SECRET_HINT=the team password manager, under ohhi relay

# One sentence about reaching the relay, shown where shares are set up and
# joined. Unset → nothing is said.
VITE_TEAM_NETWORK_NOTE=Shares work only while you are on the company tailnet.

# The team host this build's content security policy is pinned to — the bare
# host, exactly the release workflow's TEAM_HOST (no scheme, no path). Set →
# the app offers no other relay ("Use another…" / "Change…" are hidden, the
# relay field in Settings › Sync is read-only) and says the build syncs
# through this host only, because the policy would refuse any other. Unset →
# a generic build: any relay may be chosen.
VITE_TEAM_HOST=relay.example.com
