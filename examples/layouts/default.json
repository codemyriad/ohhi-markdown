{
  "$schema": "ohhi.layout.v1",
  "regions": {
    "header": "toolbar",
    "navigator": "drawer",
    "rail": "dock",
    "tabs": "always",
    "statusbar": "merged",
    "format": "bottom",
    "status": "corner",
    "selection": "on"
  },
  "bars": {
    "toolbar.left": [
      "nav"
    ],
    "toolbar.center": [],
    "toolbar.right": [
      "sync",
      "drawer",
      "session",
      "inspector",
      "help"
    ],
    "format": [
      "format.paragraph-style",
      "|",
      "format.bold",
      "format.italic",
      "format.strike",
      "format.highlight",
      "format.code",
      "|",
      "format.list",
      "format.ordered-list",
      "format.task",
      "format.outdent",
      "format.indent",
      "|",
      "format.quote",
      "format.callout",
      "format.code-block",
      "|",
      "format.wikilink",
      "format.link",
      "format.table",
      "format.image",
      "|",
      "note.comment"
    ],
    "statusbar": [
      "pane.lead",
      "|",
      "sync"
    ],
    "status": [
      "words",
      "chars"
    ],
    "tabs": [
      "workspace.split-right",
      "workspace.split-down"
    ],
    "selection": [
      "note.comment",
      "ai.ask-selection"
    ]
  },
  "toolbar": {
    "position": "top"
  },
  "dock": {
    "position": "top-right"
  },
  "panes": {
    "borders": "hairline",
    "focusMark": true,
    "lead": false,
    "open": "replace"
  },
  "views": [
    "inspector",
    "log",
    "shared",
    "session"
  ],
  "editor": {
    "measure": "comfortable",
    "typewriter": false,
    "inlineTitle": true
  },
  "focus": {
    "keep": [
      "toolbar",
      "format"
    ]
  }
}
